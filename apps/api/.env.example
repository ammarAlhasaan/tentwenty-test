# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# SQLite database file. Relative paths resolve against apps/api,
# not the directory the process was started from.
DATABASE_PATH=./data/margin.sqlite

# The single browser origin allowed to call this API, with credentials.
# Must be http or https. Normalised to a bare origin, so a trailing slash or a
# path is accepted and trimmed (browsers send Origin without either).
FRONTEND_ORIGIN=http://localhost:3000

# Signs the session cookie. Left unset on purpose: a development default applies
# automatically, so no edit is needed locally. Setting it to an empty value here
# would fail validation rather than fall back to that default.
# In production it MUST be set to a real secret of at least 32 characters --
# startup aborts otherwise. Generate one with: openssl rand -base64 48
# SESSION_SECRET=

# How long a session stays valid, in hours (1-720). The window slides: it is
# refreshed on every response, so an active user is not signed out mid-session.
SESSION_TTL_HOURS=12

# Largest spreadsheet upload accepted, in bytes. Rejected before the file is
# read, so the limit costs nothing to enforce.
MAX_UPLOAD_BYTES=10485760
