!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace
.idea/
apps/api/data/*.db
apps/api/data/*.db-shm
apps/api/data/*.db-wal
apps/api/data/*.sqlite
apps/api/data/*.sqlite-shm
apps/api/data/*.sqlite-wal

# Generated by `prisma generate` from apps/api/prisma/schema.prisma.
apps/api/src/generated/

temp/*
