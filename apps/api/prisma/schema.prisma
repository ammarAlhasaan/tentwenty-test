// Prisma 7 schema. The datasource URL lives in prisma7.config.ts, and the
// runtime opens the same file through the better-sqlite3 driver adapter.
//
// Every model maps onto the tables BE-03 already created by hand, so an
// existing database is adopted rather than rebuilt.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  // Written by the application. A SQL-function default cannot round-trip
  // through SQLite introspection, so Prisma would report permanent drift.
  createdAt    String   @map("created_at")
  imports      Import[]

  @@map("users")
}

model Session {
  sid       String @id
  data      String
  // Milliseconds since the epoch. BigInt because the value exceeds Prisma's
  // 32-bit Int, and the column must stay INTEGER for existing rows.
  expiresAt BigInt @map("expires_at")

  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model Employee {
  employeeNo String            @id @map("employee_no")
  name       String
  salaries   Salary[]
  entries    TimesheetEntry[]

  @@map("employees")
}

model Salary {
  employeeNo String   @map("employee_no")
  year       Int
  month      Int
  amount     Float
  employee   Employee @relation(fields: [employeeNo], references: [employeeNo], onDelete: NoAction, onUpdate: NoAction)

  @@id([employeeNo, year, month])
  @@map("salaries")
}

model Project {
  refCode    String  @id @map("ref_code")
  name       String
  price      Float?
  salesYear  Int?    @map("sales_year")
  salesMonth Int?    @map("sales_month")
  category   String?
  status     String?

  @@map("projects")
}

model TimesheetEntry {
  id            Int      @id @default(autoincrement())
  year          Int
  month         Int
  employeeNo    String   @map("employee_no")
  employeeName  String   @map("employee_name")
  typeOfExpense String?  @map("type_of_expense")
  department    String
  designation   String?
  category      String
  refCode       String   @map("ref_code")
  taskName      String?  @map("task_name")
  companyName   String?  @map("company_name")
  description   String?
  hours         Float
  employee      Employee @relation(fields: [employeeNo], references: [employeeNo], onDelete: NoAction, onUpdate: NoAction)

  @@index([year, month], map: "idx_timesheet_period")
  @@index([refCode], map: "idx_timesheet_ref")
  @@index([employeeNo, year, month], map: "idx_timesheet_employee")
  @@map("timesheet_entries")
}

model Import {
  id           Int    @id @default(autoincrement())
  kind         String
  filename     String
  uploadedAt   String @map("uploaded_at")
  uploadedBy   Int?   @map("uploaded_by")
  rowsAccepted Int    @map("rows_accepted")
  periods      String
  warnings     String
  user         User?  @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("imports")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}
