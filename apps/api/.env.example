# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# SQLite database file. Relative paths resolve against apps/api,
# not the directory the process was started from.
DATABASE_PATH=./data/margin.sqlite

# The single browser origin allowed to call this API, with credentials.
# Must be http or https. Normalised to a bare origin, so a trailing slash or a
# path is accepted and trimmed (browsers send Origin without either).
FRONTEND_ORIGIN=http://localhost:3000
